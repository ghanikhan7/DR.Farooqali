# Firebase Web App Configuration (Cloud Firestore & Firebase Auth)
# Copy this file to `.env` for local development and add these variables in Vercel Project Settings -> Environment Variables.
# Never put Firebase Admin SDK private service-account keys in frontend environment variables.

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id-optional

# Authorized Admin Firebase Auth UID (only this UID can update consultation fee & manage appointments)
VITE_FIREBASE_ADMIN_UID=your-authorized-admin-firebase-uid
